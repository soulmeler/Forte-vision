{
  "name": "vision-forte",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "description": "Vision Forte — проверка кассовых операций через API сервера модели",
  "main": "electron/platform.cjs",
  "scripts": {
    "start": "electron .",
    "platform": "electron .",
    "web": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/distribute.mjs mac arm64 --dir",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist:mac": "node scripts/distribute.mjs mac arm64",
    "dist:mac:intel": "node scripts/distribute.mjs mac x64",
    "dist:win": "node scripts/distribute.mjs win x64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kz.visionforte.desktop",
    "productName": "Vision Forte",
    "asar": true,
    "files": [
      "electron/platform.cjs",
      "electron/runtime.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/platform",
        "to": "platform",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/*.log",
          "!**/*.sqlite*"
        ]
      },
      {
        "from": "runtime/platform/node_modules",
        "to": "platform/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "Vision-Forte-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "binaries": [
        "Contents/Resources/platform/bin/ffmpeg",
        "Contents/Resources/platform/bin/ffprobe"
      ]
    },
    "dmg": {
      "title": "Vision Forte ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vision Forte",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "soulmeler",
        "repo": "Forte-vision"
      }
    ],
    "afterPack": "scripts/verify-package.cjs",
    "afterSign": "scripts/verify-signature.cjs"
  },
  "author": "Vision Forte team",
  "repository": {
    "type": "git",
    "url": "https://github.com/soulmeler/Forte-vision.git"
  }
}
