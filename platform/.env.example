# npm start / npm run dev creates .env with a random key when it does not exist.
HOST=127.0.0.1
PORT=3001
LOCAL_AUTO_SESSION=true
# Replace with a random value of at least 24 characters when configuring manually.
FORTE_API_KEY=
MAX_UPLOAD_MB=100
MAX_ARCHIVE_MB=500
MAX_ARCHIVE_FILES=100
MAX_ARCHIVE_EXPANDED_MB=2048
MAX_STORAGE_MB=4096
RETENTION_DAYS=7
JOB_TIMEOUT_MS=1260000
MODEL_LOAD_TIMEOUT_MS=60000
MAX_CONCURRENT_JOBS=1
MAX_PENDING_JOBS=2
# DATA_DIR=./data
# MODEL_DIR=./models/weights
# PYTHON_BIN=/absolute/path/to/venv/bin/python
# FORTE_FFMPEG_PATH=/absolute/path/to/ffmpeg
# FORTE_FFPROBE_PATH=/absolute/path/to/ffprobe
# PUBLIC_ORIGIN=https://your-internal-host.example
